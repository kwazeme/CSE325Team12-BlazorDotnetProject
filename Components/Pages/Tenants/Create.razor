@page "/tenants/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using PropertyHub.Data

@inject ApplicationDbContext _context
@inject NavigationManager Navigation
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer
@attribute [Authorize]

<div class="container mt-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            
            @* --- Header Section --- *@
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold text-dark mb-0">
                        <i class="bi bi-person-plus text-primary me-2"></i>Add New Tenant
                    </h3>
                    <p class="text-muted small">Enter the personal and contact details for the new resident.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/tenants")'>
                    <i class="bi bi-arrow-left"></i> Back to List
                </button>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    @if (editContext != null)
                    {
                        <EditForm EditContext="editContext" OnSubmit="HandleValidSubmit" FormName="CreateTenantForm">
                            <DataAnnotationsValidator />
                            
                            @* Custom Validation Summary *@
                            <ValidationSummary class="alert alert-danger py-2 mb-4" />

                            <div class="row g-4">
                                @* --- Name --- *@
                                <div class="col-12">
                                    <label class="form-label fw-bold">Full Name</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                                        <InputText class="form-control" @bind-Value="tenant.Name" placeholder="e.g. John Doe" />
                                    </div>
                                    <ValidationMessage For="@(() => tenant.Name)" class="text-danger small" />
                                </div>

                                @* --- Email --- *@
                                <div class="col-12">
                                    <label class="form-label fw-bold">Email Address</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                                        <InputText class="form-control" @bind-Value="tenant.Email" placeholder="name@example.com" />
                                    </div>
                                    <ValidationMessage For="@(() => tenant.Email)" class="text-danger small" />
                                </div>

                                @* --- Phone --- *@
                                <div class="col-12">
                                    <label class="form-label fw-bold">Phone Number</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="bi bi-telephone"></i></span>
                                        <InputText class="form-control" @bind-Value="tenant.PhoneNumber" placeholder="(555) 000-0000" />
                                    </div>
                                    <ValidationMessage For="@(() => tenant.PhoneNumber)" class="text-danger small" />
                                </div>
                            </div>

                            @* --- Action Buttons --- *@
                            <div class="d-flex justify-content-end gap-2 mt-5 pt-3 border-top">
                                <button type="button" class="btn btn-light px-4" @onclick='() => Navigation.NavigateTo("/tenants")'>
                                    Cancel
                                </button>
                                <button type="submit" class="btn btn-primary px-5 shadow-sm fw-bold">
                                    <i class="bi bi-person-plus-fill me-2"></i>Save Tenant
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2">Initializing form...</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [SupplyParameterFromForm]
    private Tenant tenant { get; set; } = new();

    private EditContext? editContext;
    private ValidationMessageStore? messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(tenant);
        messageStore = new ValidationMessageStore(editContext);

        var userId = await GetUserIdAsync();
        if (userId != null)
        {
            tenant.OwnerId = userId;
        }

        editContext.OnFieldChanged += (s, e) => messageStore?.Clear(e.FieldIdentifier);
    }

    private async Task HandleValidSubmit()
    {
        messageStore?.Clear();

        // Check validation before logic
        if (!editContext!.Validate()) return;

        if (string.IsNullOrEmpty(tenant.OwnerId))
        {
            tenant.OwnerId = await GetUserIdAsync();
        }

        // Custom Duplicate Check
        if (!string.IsNullOrEmpty(tenant.OwnerId) && !string.IsNullOrEmpty(tenant.Email))
        {
            var emailExists = await _context.Tenants
                .AnyAsync(t => t.Email.ToLower() == tenant.Email.ToLower() 
                            && t.OwnerId == tenant.OwnerId);

            if (emailExists)
            {
                messageStore?.Add(editContext!.Field(nameof(tenant.Email)), 
                    "You already have a tenant registered with this email address.");
                editContext?.NotifyValidationStateChanged();
                return;
            }

            _context.Tenants.Add(tenant);
            await _context.SaveChangesAsync();
            Navigation.NavigateTo("/tenants");
        }
    }

    private async Task<string?> GetUserIdAsync()
    {
        var authState = await AuthenticationStateTask;
        return UserManager.GetUserId(authState.User);
    }
}