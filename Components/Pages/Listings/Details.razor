@page "/listings/details/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using PropertyHub.Data

@inject ApplicationDbContext _context
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer
@inject NavigationManager Navigation

@attribute [Authorize]

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            @* --- Top Navigation & Title --- *@
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold text-dark mb-0">Property Profile</h3>
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => Navigation.NavigateTo("/listings")'>
                    <i class="bi bi-arrow-left"></i> Back to List
                </button>
            </div>

            @if (listing == null)
            {
                <div class="text-center mt-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading property details...</p>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 overflow-hidden">
                    @* --- Hero Header Section --- *@
                    <div class="card-header bg-primary text-white py-4 text-center">
                        <i class="bi bi-building fs-1 mb-2"></i>
                        <h4 class="mb-0 fw-bold">@listing.Address</h4>
                        <span class="badge bg-white text-primary mt-2">@listing.ListingType</span>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <div class="row g-4">
                            @* --- Location Section --- *@
                            <div class="col-md-6">
                                <label class="text-muted small text-uppercase fw-bold border-bottom d-block pb-1 mb-3">Location</label>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-light p-2 rounded-circle me-3">
                                        <i class="bi bi-geo-alt text-primary"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">City & State</small>
                                        <span class="fw-bold">@listing.City, @listing.State</span>
                                    </div>
                                </div>
                            </div>

                            @* --- Financial Section --- *@
                            <div class="col-md-6">
                                <label class="text-muted small text-uppercase fw-bold border-bottom d-block pb-1 mb-3">Financials</label>
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-light p-2 rounded-circle me-3">
                                        <i class="bi bi-cash-stack text-success"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Monthly Rent</small>
                                        <span class="fw-bold fs-5 text-success">@listing.RentAmount.ToString("C")</span>
                                    </div>
                                </div>
                            </div>

                            @* --- Quick Stats (Optional Placeholder for future fields) --- *@
                            <div class="col-12">
                                <div class="p-3 bg-light rounded-3 d-flex justify-content-around text-center">
                                    <div>
                                        <i class="bi bi-tag text-muted me-1"></i>
                                        <span class="small text-muted">ID: #@listing.Id</span>
                                    </div>
                                    <div>
                                        <i class="bi bi-shield-check text-muted me-1"></i>
                                        <span class="small text-muted">Verified Listing</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- Action Footer --- *@
                    <div class="card-footer bg-white border-top-0 p-4 pt-0">
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn btn-outline-warning px-4" @onclick='() => Navigation.NavigateTo($"/listings/edit/{Id}")'>
                                <i class="bi bi-pencil me-1"></i> Edit Property
                            </button>
                            <button class="btn btn-primary px-4" @onclick='() => Navigation.NavigateTo("/listings")'>
                                <i class="bi bi-list-ul me-1"></i> Return to Property Listing
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [Parameter] public int Id { get; set; }
    private Listing? listing;

    protected override async Task OnInitializedAsync()
    {
        var userId = await GetUserIdAsync();
        listing = await _context.Listings
            .Where(l => l.OwnerId == userId && l.Id == Id)
            .FirstOrDefaultAsync();
    }

    private async Task<string?> GetUserIdAsync()
    {
        var authState = await AuthenticationStateTask;
        return UserManager.GetUserId(authState.User);
    }
}