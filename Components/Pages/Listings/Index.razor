@page "/listings"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PropertyHub.Data

@inject ApplicationDbContext _context
@inject NavigationManager Navigation
@inject UserManager<ApplicationUser> UserManager

@rendermode InteractiveServer
@attribute [Authorize]

<h3>Listings</h3>

@* Fix: Navigation logic for Create button *@
<button class="btn btn-primary mb-2" @onclick='() => Navigation.NavigateTo("/listings/create")'>Add Listing</button>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Address</th>
            <th>City</th>
            <th>State</th>
            <th>Type</th>
            <th>Rent</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (listings != null)
        {
            @foreach (var listing in listings)
            {
                <tr>
                    <td>@listing.Address</td>
                    <td>@listing.City</td>
                    <td>@listing.State</td>
                    <td>@listing.ListingType</td>
                    <td>@listing.RentAmount.ToString("C")</td>
                    <td>
                        @* Fix: Logic for View and Edit navigation *@
                        <button class="btn btn-info btn-sm" @onclick='() => Navigation.NavigateTo($"/listings/details/{listing.Id}")'>View</button>
                        <button class="btn btn-warning btn-sm" @onclick='() => Navigation.NavigateTo($"/listings/edit/{listing.Id}")'>Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => ShowDeleteModal(listing.Id)">Delete</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<DeleteDialog @bind-Show="showDialog" OnConfirm="DeleteListing"
              Title="Delete Listing" Message="Are you sure you want to delete this listing?" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private List<Listing> listings = new();
    private bool showDialog = false;
    private int selectedListingId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var userId = await GetUserIdAsync();
        listings = await _context.Listings
            .Where(l => l.OwnerId == userId)
            .ToListAsync();
    }

    private void ShowDeleteModal(int id)
    {
        selectedListingId = id;
        showDialog = true;
    }

    private async Task DeleteListing()
    {
        var userId = await GetUserIdAsync();
        var listing = await _context.Listings
            .FirstOrDefaultAsync(l => l.Id == selectedListingId && l.OwnerId == userId);
        
        if (listing != null)
        {
            _context.Listings.Remove(listing);
            await _context.SaveChangesAsync();
            
            // Refresh the local list to update the UI
            await LoadData();
            showDialog = false;
        }
    }

    private async Task<string?> GetUserIdAsync()
    {
        var authState = await AuthenticationStateTask;
        return UserManager.GetUserId(authState.User);
    }
}
